{
	"$schema": "./node_modules/knip/schema.json",
	"entry": [
		"src/server/index.ts!",
		"src/client/main.tsx!",
		"src/client/box-windows/frame.ts!", // Built by Bun on the first Box frame request.
		"src/server/database/{seed,teardown}.ts!",
		"src/box-sdk/*.ts!", // Public SDK for third-party Boxes.
		"src/boxes/*/{server.ts,shared-descriptor.ts,client.tsx,logic.ts,ui.ts}!", // Loaded from Box folders at runtime.
		"e2e/server.ts", // Spawned by the browser harness. Its imports never satisfy production reachability.
		"e2e/fixtures/boxes/*/{server.ts,shared-descriptor.ts,client.tsx}", // Loaded by the Box host in browser tests.
		"scripts/{check-clones,publish-docker,write-build-metadata}.ts",
		"scripts/stream-eyes/{eyes.mjs,preview.tsx,server.ts}", // Standalone trace CLI, Vite preview page and spawned preview server.
		"tools/oxlint/*/index.ts" // Loaded by Oxlint.
	],
	"project": [
		"src/**/*.{js,ts,tsx}!",
		"{scripts,e2e,tools}/**/*.{js,mjs,ts,tsx}",
		"!**/*.{test,spec}.{ts,tsx}!",
		"!e2e/fixtures/boxes/*/**/*.js", // Guest scripts and vendored packages loaded by the Box host.
		"!src/**/{test-fixtures.ts,test-fixtures/**}!", // Intentional test support.
		"!src/server/contract/*-test-fixtures.ts!",
		"!src/server/{image/image-fixtures,lorebook/fixtures,sillytavern/fixtures}.ts!"
	],
	"includeEntryExports": true,
	"ignoreIssues": {
		"src/box-sdk/*.ts": ["exports", "types"] // Box authors import any SDK export.
	},
	"node": false, // Node's test-* discovery misclassifies the live Test Connection endpoint.
	"ignoreExportsUsedInFile": true, // The declaration already has a production caller in its own module.
	"ignoreUnresolved": ["e2e/server.ts"], // The harness spawns it relative to the repo root.
	"preprocessor": "./scripts/knip-allowlist.ts",
	"preprocessorOptions": {
		"src/boxes/*/{server.ts,shared-descriptor.ts,client.tsx,logic.ts,ui.ts}": ["default"], // Runtime Box entry points are discovered by folder and load their default exports.
		"e2e/fixtures/boxes/*/{server.ts,shared-descriptor.ts,client.tsx}": ["default"], // Browser test Boxes use the same runtime loading.
		"tools/oxlint/*/index.ts": ["default"], // Oxlint reads each configured plugin's default export.
		"src/shared/contract/box-row-reference.ts": ["ParticipantId"], // Public Row Reference schema re-exported by the Box SDK.
		"src/server/authoring/candidate.ts": ["AUTHORED_ID"], // Production Box export and submission CLIs validate saved ids.
		"src/server/box/versions.ts": ["installedLatest"], // Production Box export and submission CLIs inspect installed versions.

		// HTTP and stored-value surface for owner review.
		"src/shared/contract/macro-variables.ts": ["MacroVariablesEditBody"], // Names the input of the Macro Variable edit command.
		"src/shared/contract/prompt-preset.ts": ["SillyTavernImportApplied", "PromptPresetListResponse", "PromptPresetConflict"], // Name these HTTP outcomes for consumers of the Prompt Preset API.
		"src/shared/contract/chat-import.ts": ["ChatImportReceiptParticipant", "ImportDetailsArtifactAvailability"], // Name the participant receipt and artifact states returned by Chat import.
		"src/boxes/memory/contract.ts": ["MemoryRelevanceScore"], // Names the relevance enum written into each Memory trace.

		// Existing tests import these live production seams to assert outcomes, identities and typed fixture inputs.
		"src/server/artifact/index.ts": ["ArtifactStoreError", "attachmentDisposition", "ArtifactModule"], // Tests distinguish store failures and verify the HTTP download header.
		"src/server/character-library/index.ts": ["CharacterNotFoundError", "InvalidCharacterCommandError", "InvalidCharacterDefinitionError", "CharacterCommand"], // Tests distinguish Character command failures and submit typed requests.
		"src/server/connection-secrets/index.ts": ["bootstrapConnectionSecretKey", "ConnectionSecretBootstrapError", "CONNECTION_SECRET_KEY_ENV", "CONNECTION_SECRET_FORMAT_VERSION"], // Tests verify the persisted secret format and reject bootstrap misconfiguration.
		"src/server/conversation/index.ts": [
			"ConversationWriteObserverMissingError", "ContinuationUnavailableError", "InvalidConversationCreationError", "ParticipantNotRemovableError",
			"SiblingVariantUnavailableError", "deriveMessageSwipeEligibility", "DEFAULT_HISTORY_PAGE_SIZE", "MAX_HISTORY_PAGE_SIZE", "readSelectedHistory",
			"ContinuationUnavailableReason", "AuthorStampSnapshot", "ConversationArtifactSeed", "ConversationCommand", "MessageSwipeEligibility"
		], // Keep the Conversation barrel as the one import path for command, capability and history assertions.
		"src/server/prompt-compiler/index.ts": ["CompilePromptInput", "PromptBlock"], // Tests type their Prompt Plan and recipe fixtures against the live compiler.
		"src/server/prompt-preset/index.ts": ["InvalidPromptPresetOperationError", "PromptPresetDeletionImpactChangedError"], // Tests distinguish invalid commands and stale deletion impact.
		"src/server/workflows/index.ts": ["runGenerationLifecycle", "StartGenerationRuntimeInput"] // Tests drive the same Generation lifecycle and runtime as production.
	}
}
