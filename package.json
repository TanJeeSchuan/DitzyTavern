{
	"name": "ditzytavern",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"dev:server": "bun --watch src/server/index.ts",
		"dev:client": "vite",
		"dev:stop": "bun -e \"process.exit(Bun.spawnSync(process.platform === 'win32' ? ['powershell', '-c', 'Stop-Process -Force -Id (Get-NetTCPConnection -State Listen -LocalPort 3000,5173).OwningProcess'] : ['fuser', '-k', '3000/tcp', '5173/tcp'], { stdio: ['inherit', 'inherit', 'inherit'] }).exitCode)\"",
		"build": "vite build",
		"box:build": "bun scripts/build-box-client.ts",
		"start": "bun src/server/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:seed": "bun src/server/database/seed.ts",
		"db:teardown": "bun src/server/database/teardown.ts",
		"db:seed:race-avatars": "bun scripts/seed-race-avatars.ts",
		"db:teardown:race-avatars": "bun scripts/teardown-race-avatars.ts",
		"db:import": "bun src/server/database/import-chat.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:rules": "node --test --test-reporter=dot --test-isolation=none --experimental-strip-types \"tools/oxlint/*/rules/*.test.ts\"",
		"audit:comments": "bun scripts/audit-comments.ts",
		"check:contracts": "bun scripts/check-contract-ownership.ts",
		"check:clones": "jscpd src",
		"typecheck": "tsc --noEmit",
		"typecheck:tools": "bun node_modules/typescript5/bin/tsc -p tsconfig.tools.json",
		"test": "bun test --only-failures --parallel=3 --no-isolate --path-ignore-patterns '**/*.spec.ts' --preload ./src/client/test-fixtures/window.ts --preload ./src/server/test-fixtures/boxes.ts src",
		"test:publication": "bun test scripts/publish-docker.test.ts scripts/write-build-metadata.test.ts",
		"check": "bun scripts/run-check.ts check",
		"screenshots:capture": "node scripts/capture-screenshots.ts",
		"test:e2e": "bun scripts/run-check.ts e2e",
		"test:e2e:harness": "node --test --test-reporter=dot e2e/harness.test.ts",
		"profile:actions": "bun --cpu-prof-md --cpu-prof-dir=.scratch/profile scripts/profile-actions.ts"
	},
	"engines": {
		"node": "26.12.1"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "^3.0.32",
		"@ai-sdk/openai-compatible": "^3.0.37",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.13",
		"@dnd-kit/dom": "^0.5.0",
		"@dnd-kit/react": "^0.5.0",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/static": "^1.4.10",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource/alegreya-sans": "^5.3.0",
		"@openrouter/ai-sdk-provider": "3.0.0",
		"@sinclair/typebox": "^0.34.52",
		"@tanstack/react-query": "^5.104.0",
		"@uwx/exif-be-gone-web": "^1.6.7",
		"ai": "^7.0.79",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.30",
		"eventsource-parser": "^4.1.1",
		"flare-redact": "^1.6.1",
		"json-edit-react": "^1.0.0",
		"lucide-react": "^1.31.0",
		"markdown-it": "^15.0.3",
		"radix-ui": "^1.6.7",
		"re2js": "2.8.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.89.0",
		"tailwind-merge": "^3.6.0",
		"tokenx": "2.1.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.87.0",
		"@playwright/test": "1.62.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"drizzle-kit": "^0.31.11",
		"jscpd": "^5.0.16",
		"lightningcss": "^1.33.0",
		"oxlint": "1.87.0",
		"shadcn": "^4.22.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript5": "npm:typescript@5.9.3",
		"vite": "^8.3.4"
	}
}
