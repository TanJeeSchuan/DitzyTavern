{
	"name": "ditzytavern",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.3.14",
	"scripts": {
		"dev:server": "bun --watch src/server/index.ts",
		"dev:client": "vite",
		"build": "vite build",
		"start": "bun src/server/index.ts",
		"db:generate": "drizzle-kit generate",
		"db:seed": "bun src/server/database/seed.ts",
		"db:teardown": "bun src/server/database/teardown.ts",
		"db:import": "bun src/server/database/import-chat.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:rules": "node --test --experimental-strip-types \"tools/oxlint/*/rules/*.test.ts\"",
		"audit:comments": "bun scripts/audit-comments.ts",
		"check:contracts": "bun scripts/check-contract-ownership.ts",
		"check:clones": "jscpd src",
		"typecheck": "tsc --noEmit",
		"typecheck:tools": "bun node_modules/typescript5/bin/tsc -p tsconfig.tools.json",
		"test": "bun test src",
		"check": "bun run lint && bun run lint:rules && bun run check:contracts && bun run typecheck && bun run typecheck:tools && bun run test",
		"screenshots:capture": "node scripts/capture-screenshots.ts",
		"smoke:import": "node scripts/import-chat-smoke.ts"
	},
	"dependencies": {
		"@ai-sdk/deepseek": "^3.0.32",
		"@ai-sdk/openai-compatible": "^3.0.37",
		"@elysiajs/eden": "^1.4.9",
		"@elysiajs/static": "^1.4.10",
		"@fontsource-variable/geist": "^5.3.0",
		"@openrouter/ai-sdk-provider": "3.0.0",
		"@sinclair/typebox": "^0.34.52",
		"ai": "^7.0.79",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"elysia": "^1.4.29",
		"json-edit-react": "^1.0.0",
		"lucide-react": "^1.31.0",
		"radix-ui": "^1.6.7",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"shadcn": "^4.18.0",
		"tailwind-merge": "^3.6.0",
		"tokenx": "2.1.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@oxlint/plugins": "1.79.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"drizzle-kit": "^0.31.10",
		"jscpd": "^5.0.16",
		"oxlint": "1.79.0",
		"playwright": "1.62.1",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"typescript5": "npm:typescript@5.9.3",
		"vite": "^8.2.1"
	}
}
